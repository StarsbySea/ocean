{
    "version": "3.5",
    "description": "A light-weight C/C++ IDE based on Qt",
    "homepage": "https://github.com/royqh1979/RedPanda-CPP",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/royqh1979/RedPanda-CPP/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v3.5/RedPanda.C%2B%2B.3.5.0.win64.MinGW64_15.3.0.Portable.7z",
            "hash": "8ebab1e723d25f2f8eef122afdd9e50a7540d409fc9a282286a89504da5e3238"
        },
        "32bit": {
            "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v3.5/RedPanda.C%2B%2B.3.5.0.win32.MinGW32_15.3.0.Portable.7z",
            "hash": "043b744c0d31a1f8b0970b48210c6bdef8e7b0d84a5d863088617b2e728bf362"
        }
    },
    "extract_dir": "RedPanda-Cpp",
    "persist": "config",
    "shortcuts": [
        [
            "RedPandaIDE.exe",
            "RedPanda C++"
        ]
    ],
    "checkver": {
        "script": [
            "$release = Invoke-RestMethod 'https://api.github.com/repos/royqh1979/RedPanda-CPP/releases/latest'",
            "$version = $release.tag_name -replace '^v', ''",
            "$names = $release.assets.name -join \"`n\"",
            "$win64 = [regex]::Match($names, 'RedPanda\\.C\\+\\+\\.(?<assetversion>[\\d.]+)\\.win64\\.MinGW64_(?<gcc>[\\d.]+)\\.Portable\\.7z')",
            "$win32 = [regex]::Match($names, 'RedPanda\\.C\\+\\+\\.(?<assetversion>[\\d.]+)\\.win32\\.MinGW32_(?<gcc>[\\d.]+)\\.Portable\\.7z')",
            "if ($win64.Success -and $win32.Success -and $win64.Groups['assetversion'].Value -eq $win32.Groups['assetversion'].Value) { \"$version $($win64.Groups['assetversion'].Value) $($win64.Groups['gcc'].Value) $($win32.Groups['gcc'].Value)\" }"
        ],
        "regex": "(?<version>[\\d.]+) (?<assetversion>[\\d.]+) (?<gccversion>[\\d.]+) (?<x86gccversion>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v$version/RedPanda.C%2B%2B.$matchAssetversion.win64.MinGW64_$matchGccversion.Portable.7z"
            },
            "32bit": {
                "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v$version/RedPanda.C%2B%2B.$matchAssetversion.win32.MinGW32_$matchX86gccversion.Portable.7z"
            }
        }
    }
}
