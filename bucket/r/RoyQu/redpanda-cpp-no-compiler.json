    "extract_dir": "RedPanda-Cpp",
    "persist": "config",
    "shortcuts": [
        [
            "RedPandaIDE.exe",
            "RedPanda C++"
        ]
    ],
    "checkver": {
        "script": [
            "$release = Invoke-RestMethod 'https://api.github.com/repos/royqh1979/RedPanda-CPP/releases/latest'",
            "$version = $release.tag_name -replace '^v', ''",
            "$asset = $release.assets | Where-Object { $_.name -eq \"RedPanda.C++.$version.win64.NoCompiler.Portable.7z\" } | Select-Object -First 1",
            "if ($asset) { $version }"
        ],
        "regex": "(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v$version/RedPanda.C%2B%2B.$version.win64.NoCompiler.Portable.7z"
            },
            "32bit": {
                "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v$version/RedPanda.C%2B%2B.$version.win32.NoCompiler.Portable.7z"
            }
        }
    }
}
