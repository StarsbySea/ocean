{
    "version": "3.5",
    "description": "A light-weight C/C++ IDE based on Qt.",
    "homepage": "https://github.com/royqh1979/RedPanda-CPP",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/royqh1979/RedPanda-CPP/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v3.5/RedPanda.C%2B%2B.3.5.0.win64.NoCompiler.Portable.7z",
            "hash": "d5b263b191643bae3c0b245991ed58483954a35ddbfe218bdbf79c43404b612e"
        },
        "32bit": {
            "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v3.5/RedPanda.C%2B%2B.3.5.0.win32.NoCompiler.Portable.7z",
            "hash": "90f4246c39e5b2c10120052fba3227986ac2c5b02e8b243e41c5a9c936739e65"
        }
    },
    "extract_dir": "RedPanda-Cpp",
    "persist": "config",
    "shortcuts": [
        [
            "RedPandaIDE.exe",
            "RedPanda C++"
        ]
    ],
    "checkver": {
        "script": [
            "$release = Invoke-RestMethod 'https://api.github.com/repos/royqh1979/RedPanda-CPP/releases/latest'",
            "$version = $release.tag_name -replace '^v', ''",
            "$names = $release.assets.name -join \"`n\"",
            "$win64 = [regex]::Match($names, 'RedPanda\\.C\\+\\+\\.(?<assetversion>[\\d.]+)\\.win64\\.NoCompiler\\.Portable\\.7z')",
            "$win32 = [regex]::Match($names, 'RedPanda\\.C\\+\\+\\.(?<assetversion>[\\d.]+)\\.win32\\.NoCompiler\\.Portable\\.7z')",
            "if ($win64.Success -and $win32.Success -and $win64.Groups['assetversion'].Value -eq $win32.Groups['assetversion'].Value) { \"$version $($win64.Groups['assetversion'].Value)\" }"
        ],
        "regex": "(?<version>[\\d.]+) (?<assetversion>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v$version/RedPanda.C%2B%2B.$matchAssetversion.win64.NoCompiler.Portable.7z"
            },
            "32bit": {
                "url": "https://github.com/royqh1979/RedPanda-CPP/releases/download/v$version/RedPanda.C%2B%2B.$matchAssetversion.win32.NoCompiler.Portable.7z"
            }
        }
    }
}
