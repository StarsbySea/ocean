{
    "version": "8.3.4",
    "description": "The HT-IDE3000 is an integrated development environment for designing 8-bit MCU applications.",
    "homepage": "https://www.holtek.com/",
    "license": "Freeware",
    "url": "https://www.holtek.com.cn/WebAPI/9f0f1311-eed7-4825-8cb9-37531bde38f7#/dl.zip",
    "hash": "b5f58cf37f85ec98261082510e56cde4e8fa7774b7707a8d90196c4d5e3b1b7c",
    "installer": {
        "script": "Get-Item \"$dir\\HT-IDE3K*Setup.exe\" | Expand-InnoArchive -Destination \"$dir\" -Removal"
    },
    "shortcuts": [
        [
            "BIN\\Bin2asm.exe",
            "HT-IDE3000\\BinToAsm"
        ],
        [
            "BIN\\hdiag32.exe",
            "HT-IDE3000\\Diagnosis"
        ],
        [
            "BIN\\HT-IDE3000.exe",
            "HT-IDE3000\\HT-IDE3000"
        ],
        [
            "BIN\\HLIBW32.exe",
            "HT-IDE3000\\Library Manager"
        ],
        [
            "BIN\\Option Viewer.exe",
            "HT-IDE3000\\Option Viewer"
        ],
        [
            "DOC\\HT-IDE3000UsersGuide(1252).pdf",
            "HT-IDE3000\\HT-IDE3000 User's guide"
        ]
    ],
    "checkver": {
        "script": [
            "$body = @{ Keyword = 'HT-IDE3000'; CLanguageType = 3; Category = 'News'; SubCategory = 'Tools News'; PageIndex = 1; PageSize = 200 } | ConvertTo-Json",
            "$items = (Invoke-RestMethod -Method Post -Uri 'https://www.holtek.com.cn/webapi/api/Page/GetSearchResult' -ContentType 'application/json' -Body $body).Entries.SearchList",
            "$versions = $items | ForEach-Object { if ($_.Title -match '^HT-IDE3000\\s*V(?<version>[\\d.]+)\\s+Release') { [version]$matches.version } } | Sort-Object -Descending",
            "$versions[0].ToString()"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://www.holtek.com.cn/WebAPI/9f0f1311-eed7-4825-8cb9-37531bde38f7#/dl.zip"
    },
    "notes": [
        "You will need to install the device drivers manually, they are available at:",
        "$dir\\Driver"
    ]
}
