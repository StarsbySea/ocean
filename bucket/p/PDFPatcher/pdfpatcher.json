{
    "version": "1.0.0.3823",
    "description": "PDFPatcher is a tool for modifying information in PDF files. (Chinese language only)",
    "homepage": "https://github.com/wmjordan/PDFPatcher",
    "license": "Freeware",
    "url": "https://github.com/wmjordan/PDFPatcher/files/7999822/PDFPatcher.1.0.0.3823.7z.zip",
    "hash": "C7A023FA373CB1B64A72649847FAA5644EBA63388B0AD5026C4FD27DA9F1DA5E",
    "shortcuts": [
        [
            "PDFPatcher.exe",
            "PDFPatcher"
        ]
    ],
    "checkver": {
        "script": [
            "$release = Invoke-RestMethod 'https://api.github.com/repos/wmjordan/PDFPatcher/releases/latest'",
            "$tag = $release.tag_name -replace '^v', ''",
            "$asset = $release.assets | Where-Object { $_.name -match '^PDFPatcher\\.[\\d.]+\\.7z$' } | Select-Object -First 1",
            "if ($asset.name -match '^PDFPatcher\\.(?<version>[\\d.]+)\\.7z$') { \"$tag $($Matches['version'])\" }"
        ],
        "regex": "(?<tag>[\\d.]+) (?<version>[\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/wmjordan/PDFPatcher/releases/download/v$matchTag/PDFPatcher.$version.7z"
    }
}
